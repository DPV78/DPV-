# Copie para .env e preencha. Nunca versione o .env.

# Chave secreta para assinar cookies de sessão (gere uma string longa e aleatória)
SECRET_KEY=troque-esta-chave

# Banco de dados (SQLite local por padrão; em produção use PostgreSQL)
DATABASE_URL=sqlite:///./carteira.db

# Claude (assistente estratégico)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

# DataJud (CNJ) - chave pública publicada na wiki do DataJud
# https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_API_KEY=

# DJEN / Comunica PJe - monitoramento por OAB (opcional, separados por vírgula: 123456/SP,654321/RJ)
DJEN_OABS=
# Formato de data aceito pela API do DJEN: iso (AAAA-MM-DD) ou br (DD/MM/AAAA)
DJEN_DATE_FORMAT=iso

# Sincronização automática (horas entre execuções; 0 desativa)
SYNC_INTERVAL_HOURS=6

# Primeiro usuário administrador (criado na primeira execução se o banco estiver vazio)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# ---- Integração autenticada com o PJe (MNI) ----
# Chave para criptografar CPF/senha do PJe de cada advogado. Gere com:  python -m app.crypto
# Guarde esta chave com segurança: sem ela, as credenciais salvas não podem ser lidas.
CREDENTIALS_KEY=
# Verificação de intimações pendentes no PJe (horas; 0 desativa)
AVISOS_INTERVAL_HOURS=2

# ---- Servidor local ----
# true somente se o acesso for por HTTPS (proxy reverso com certificado)
SESSION_HTTPS_ONLY=false
# Pasta para documentos baixados e backups
DATA_DIR=./dados
# Quantidade de backups diários mantidos em DATA_DIR/backups
BACKUP_KEEP=30
